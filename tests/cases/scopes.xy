// Each function has its own variables, and parameters are copies.
// expect-stdout: 11
// expect-stdout: 1
// expect-stdout: 30
extern printi(val)

a = 1

addten(a) {
  a = a + 10
  return a
}

printi(addten(a))
printi(a)

outer(x) {
  inner(y) {
    return y * 3
  }
  return inner(x)
}

printi(outer(10))

// A call with variable arguments must not be parsed as a declaration.
// expect-stdout: 4
// expect-stdout: 9
// expect-stdout: 5
sum(a, b) {
  return a + b
}

x = 4
y = 5
printi(x)
printi(sum(x, y))
printi(y)
